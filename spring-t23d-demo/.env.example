# Kopieren nach ".env" und Werte anpassen. ".env" wird nicht eingecheckt.

OPENAI_API_KEY=

# Absoluter Host-Pfad fuer abgelegte Skripte/Modelle, wird von docker-compose
# in den Backend-Container gemountet (noetig, damit der auf dem Host laufende
# Docker-Daemon die vom Backend gestarteten FreeCAD-Sibling-Container mit dem
# richtigen Verzeichnis mounten kann). Beispiel Windows: C:/git/demos/spring-t23d-demo/data
HOST_DATA_DIR=./data
